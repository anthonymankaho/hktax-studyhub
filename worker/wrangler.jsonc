{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hktax-studyhub-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": false,
  "vars": {
    "QWEN_BASE_URL": "https://token-plan.maas.qwencloudapi.com/compatible-mode/v1",
    "QWEN_MODEL": "qwen3.8-flash",
    "QWEN_ALLOWED_GITHUB_USER": "anthonymankaho",
    "QWEN_MONTHLY_TOKEN_QUOTA": "20000000",
    // Spare small-quota Token Plan key (secret: DASHSCOPE_API_KEY_TEMP).
    // Its plan carries qwen3.8-* models only — qwen-plus is NOT available there,
    // so pin the temp model instead of inheriting a future main-model change.
    // Optional overrides: QWEN_BASE_URL_TEMP (defaults to QWEN_BASE_URL).
    "QWEN_MODEL_TEMP": "qwen3.8-flash",
    "QWEN_MONTHLY_TOKEN_QUOTA_TEMP": "2000000",
    "GITHUB_CLIENT_ID": "Ov23liJh92zfUJkRnUX7"
  },
  "kv_namespaces": [
    { "binding": "QWEN_USAGE", "id": "e2e5930dec5d44a4b581e68ea398d12d" }
  ]
}
